APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8501,http://127.0.0.1:8501
AUTH_ENABLED=false
ADMIN_API_TOKEN=change-me
SECRET_KEY=change-me

DATABASE_URL=postgresql+asyncpg://docwise:docwise@localhost:15432/docwise
POSTGRES_HOST=localhost
POSTGRES_PORT=15432
POSTGRES_DB=docwise
POSTGRES_USER=docwise
POSTGRES_PASSWORD=docwise
SQL_ECHO=false

REDIS_URL=redis://localhost:6379/0

MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=docwise-documents
MINIO_SECURE=false

DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_API_KEY=
LLM_FAST_MODEL=deepseek-v4-flash
LLM_PRO_MODEL=deepseek-v4-pro

DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIM=2048
RERANKER_MODEL=qwen3-rerank
RERANKER_ENABLED=true

TRACE_BACKEND=local_and_langfuse
LANGFUSE_ENABLED=false
DOCWISE_API_BASE_URL=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_DOCWISE_API_BASE_URL=http://127.0.0.1:8000/api/v1
